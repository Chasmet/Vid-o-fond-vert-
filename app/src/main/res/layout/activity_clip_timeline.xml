<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/clipTopBar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:text="‹"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="♪ CLIP MUSIQUE · TIMELINE"
                android:textColor="@color/accent"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MICRO COUPÉ · PAUSE = NOUVEAU PLAN"
                android:textColor="@color/ink_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qualityButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="74dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="1080p"
            android:textColor="@color/accent"
            android:textSize="10sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/accent" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/clipPreviewCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="#00FF00"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/timelineCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clipTopBar"
        app:strokeColor="@color/surface_high"
        app:strokeWidth="1dp">

        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00FF00"
            android:keepScreenOn="true">

            <ImageView
                android:id="@+id/backgroundImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Décor image"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <com.chasmet.fondvertstudio.FillVideoView
                android:id="@+id/backgroundVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.chasmet.fondvertstudio.MaskedCameraView
                android:id="@+id/subjectPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/previewHint"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Tourne ton premier plan.\nPause, change le décor, puis reprends."
                android:textColor="#EEFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/recordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_record_badge"
                android:fontFamily="sans-serif-black"
                android:paddingStart="11dp"
                android:paddingTop="5dp"
                android:paddingEnd="11dp"
                android:paddingBottom="5dp"
                android:text="00:00"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flipCameraButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="top|end"
                android:layout_margin="7dp"
                app:backgroundTint="#B3090C11"
                app:cornerRadius="23dp"
                app:icon="@drawable/ic_flip"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/ink" />

            <TextView
                android:id="@+id/transformHint"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Glisse · pince pour zoomer"
                android:textColor="@color/ink"
                android:textSize="8sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetSubjectButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="7dp"
                android:minWidth="0dp"
                android:text="↺ 100 %"
                android:textColor="@color/accent"
                android:textSize="9sp"
                app:backgroundTint="#C9090C11"
                app:cornerRadius="13dp" />

            <LinearLayout
                android:id="@+id/processingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E6090C11"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="22dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="MONTAGE EN COURS"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/processingProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="240dp"
                    android:layout_height="9dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/accent" />

                <TextView
                    android:id="@+id/processingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Montage des plans…"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/timelineCard"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/decorCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/surface_high"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="TIMELINE DES PLANS"
                    android:textColor="@color/ink"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/timelineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 plan · prêt à tourner"
                    android:textColor="@color/accent"
                    android:textSize="9sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/timelineTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/decorCard"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/musicCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/surface_high"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="1 · DÉCOR DU PLAN"
                    android:textColor="@color/ink"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/decorStatus"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Fond vert"
                    android:textColor="@color/accent"
                    android:textSize="9sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importImageButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="68dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="IMAGE"
                android:textColor="@color/ink"
                android:textSize="8sp"
                app:cornerRadius="13dp"
                app:strokeColor="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importVideoButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="68dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:text="VIDÉO"
                android:textColor="@color/ink"
                android:textSize="8sp"
                app:cornerRadius="13dp"
                app:strokeColor="@color/cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/greenBackgroundButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:text="VERT"
                android:textColor="@color/ink"
                android:textSize="8sp"
                app:cornerRadius="13dp"
                app:strokeColor="@color/surface_high" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/musicCard"
        android:layout_width="0dp"
        android:layout_height="144dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="19dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/recordBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/surface_high"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/importAudioButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="2 · IMPORTER MUSIQUE"
                    android:textColor="@color/background"
                    android:textSize="9sp"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloadsMusicButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="108dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="5dp"
                    android:minWidth="0dp"
                    android:text="↓ TÉLÉCHARGEMENTS"
                    android:textColor="@color/cyan"
                    android:textSize="7sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/cyan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/musicPlayButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="88dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="5dp"
                    android:minWidth="0dp"
                    android:text="▶ ÉCOUTER"
                    android:textColor="@color/ink"
                    android:textSize="8sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/surface_high" />
            </LinearLayout>

            <TextView
                android:id="@+id/audioName"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Aucune musique sélectionnée"
                android:textColor="@color/ink_secondary"
                android:textSize="9sp" />

            <SeekBar
                android:id="@+id/musicSeekBar"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:max="1000"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/musicPosition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="00:00 / 00:00"
                    android:textColor="@color/ink"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/clipStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="220dp"
                    android:text="Choisis le départ du son"
                    android:textColor="@color/accent"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/recordBar"
        android:layout_width="0dp"
        android:layout_height="98dp"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recordButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="●  TOURNER"
            android:textColor="@color/ink"
            android:textSize="15sp"
            app:backgroundTint="@color/danger"
            app:cornerRadius="19dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/finishButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="112dp"
            android:layout_height="64dp"
            android:layout_marginStart="7dp"
            android:fontFamily="sans-serif-black"
            android:text="TERMINER\nMONTAGE"
            android:textColor="@color/accent"
            android:textSize="9sp"
            android:visibility="gone"
            app:cornerRadius="19dp"
            app:strokeColor="@color/accent" />

        <com.chasmet.fondvertstudio.FinalDownloadButton
            android:id="@+id/downloadButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="↓  TÉLÉCHARGER LA VIDÉO"
            android:textColor="@color/background"
            android:textSize="13sp"
            android:visibility="gone"
            app:backgroundTint="@color/accent"
            app:cornerRadius="19dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>